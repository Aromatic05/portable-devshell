{
    "schemaVersion": "1.1.0",
    "apiVersion": "5.0.0",
    "activation": "lazy",
    "id": "skill",
    "name": "portable-devshell Skill",
    "version": "0.1.0",
    "entry": "index.ts",
    "capabilities": ["assets", "worker.execute"],
    "extensions": {
        "cli.native-commands": [
            {
                "id": "skill",
                "title": "Skill",
                "summary": "Inspect and project portable-devshell Skills",
                "usage": "skill <command>"
            }
        ],
        "cli.model-commands": [
            {
                "id": "skill",
                "title": "Skill",
                "summary": "Discover and read Skills for the current model workspace",
                "usage": "skill <list|search|load|inspect|read>"
            }
        ]
    }
}
