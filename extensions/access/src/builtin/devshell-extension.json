{
    "schemaVersion": "1.1.0",
    "apiVersion": "4.1.0",
    "activation": "eager",
    "id": "access",
    "name": "portable-devshell Access",
    "version": "0.1.0",
    "entry": "index.ts",
    "capabilities": ["processes"],
    "config": {
        "access": {
            "mcp.enabled": "read",
            "mcp.listenHost": "read",
            "mcp.listenPort": "read",
            "mcp.publicBaseUrl": "read-write",
            "web.enabled": "read",
            "web.listenHost": "read",
            "web.listenPort": "read",
            "web.publicBaseUrl": "read-write"
        },
        "default": {
            "endpoints": []
        },
        "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "endpoints": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                                    "enabled": { "type": "boolean" },
                                    "provider": { "const": "cloudflared" },
                                    "target": { "enum": ["mcp", "web"] },
                                    "binary": { "type": "string", "minLength": 1 },
                                    "token": { "type": "string", "minLength": 1 },
                                    "publicUrl": { "type": "string", "minLength": 1 },
                                    "arguments": { "type": "array", "items": { "type": "string" } }
                                },
                                "required": ["id", "enabled", "provider", "target", "token"]
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                                    "enabled": { "type": "boolean" },
                                    "provider": { "const": "frp" },
                                    "target": { "enum": ["mcp", "web"] },
                                    "binary": { "type": "string", "minLength": 1 },
                                    "serverHost": { "type": "string", "minLength": 1 },
                                    "serverPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                    "remotePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                    "token": { "type": "string" },
                                    "publicUrl": { "type": "string", "minLength": 1 },
                                    "arguments": { "type": "array", "items": { "type": "string" } }
                                },
                                "required": ["id", "enabled", "provider", "target", "serverHost", "remotePort"]
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                                    "enabled": { "type": "boolean" },
                                    "provider": { "const": "ssh" },
                                    "target": { "enum": ["mcp", "web"] },
                                    "binary": { "type": "string", "minLength": 1 },
                                    "host": { "type": "string", "minLength": 1 },
                                    "user": { "type": "string", "minLength": 1 },
                                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                    "remoteBindHost": { "type": "string", "minLength": 1 },
                                    "remotePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                    "identityFile": { "type": "string", "minLength": 1 },
                                    "publicUrl": { "type": "string", "minLength": 1 },
                                    "options": { "type": "array", "items": { "type": "string" } }
                                },
                                "required": ["id", "enabled", "provider", "target", "host", "remotePort"]
                            }
                        ]
                    }
                }
            },
            "required": ["endpoints"]
        }
    },
    "extensions": {
        "cli.native-commands": [
            {
                "id": "access",
                "title": "Access",
                "summary": "Manage remote access endpoints",
                "usage": "access <command>"
            }
        ],
        "web.applications": [
            {
                "id": "access",
                "title": "Access"
            }
        ]
    }
}
