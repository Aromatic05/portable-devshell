{
    "name": "@portable-devshell/mcp-extension",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@modelcontextprotocol/client": "2.0.0",
        "@portable-devshell/extension": "workspace:*"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b --force && node ./scripts/write-dist-manifest.mjs",
        "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json",
        "test": "node ../../test/RunPackageTests.mjs --loader ./test/RegisterWorkspacePackages.mjs --concurrency 1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\""
    },
    "devDependencies": {
        "@modelcontextprotocol/node": "2.0.0",
        "@modelcontextprotocol/server": "2.0.0",
        "zod": "4.2.1"
    }
}
