{
    "schemaVersion": "1.1.0",
    "apiVersion": "5.0.0",
    "activation": "lazy",
    "id": "agent",
    "name": "portable-devshell Agent",
    "version": "0.1.3",
    "entry": "dist/builtin/index.js",
    "capabilities": ["worker.delegate", "processes", "database"],
    "extensions": {
        "cli.native-commands": [
            {
                "id": "agent",
                "title": "Agent",
                "summary": "Run and manage Agent providers",
                "usage": "agent <command>"
            }
