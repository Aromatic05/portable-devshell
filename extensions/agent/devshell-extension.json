        "cli.model-commands": [
            {
                "id": "agent",
                "title": "Agent",
                "summary": "Run and interact with Agents in the current model Workspace",
                "usage": "agent <command>"
            }
        ],
        "web.applications": [
            {
                "id": "agent",
                "title": "Agent"
            }
        ],
        "tui.pages": [
            {
                "id": "agent",
                "title": "Agent"
            }
        ],
        "web.pages": [
            {
                "id": "agent",
                "title": "Agent"
            }
        ]
    }
}
