{
    "schemaVersion": 1,
    "apiVersion": 4,
    "id": "agent",
    "name": "portable-devshell Agent",
    "version": "0.1.3",
    "entry": "index.ts",
    "capabilities": [
        "assets",
        "delegatedWorkers",
        "processes"
    ],
    "extensions": {
        "cli.native-commands": [
            {
                "id": "agent",
                "title": "Agent",
                "summary": "Run and manage Agent providers",
                "usage": "agent <command>"
            }
        ],
        "cli.model-commands": [
            {
                "id": "agent",
                "title": "Agent",
                "summary": "Run and interact with Agents in the current model Workspace",
                "usage": "agent <command>"
            }
        ],
        "web.applications": [
            {
                "id": "agent",
                "title": "Agent"
            }
        ]
    }
}
