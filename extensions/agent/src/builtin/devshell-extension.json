{
    "schemaVersion": "1.1.0",
    "apiVersion": "4.0.0",
    "activation": "lazy",
    "id": "agent",
    "name": "portable-devshell Agent",
    "version": "0.1.3",
    "entry": "index.ts",
    "capabilities": ["assets", "delegatedWorkers", "processes"],
    "extensions": {
        "cli.native-commands": [
            {
                "id": "agent",
                "title": "Agent",
