{
    "schemaVersion": "1.1.0",
    "apiVersion": "5.0.0",
    "activation": "lazy",
    "id": "comment",
    "name": "portable-devshell Comment",
    "version": "0.1.0",
    "entry": "index.ts",
    "capabilities": [
        "database",
        "instance.observe",
        "instance.events.publish",
        "context.observe",
        "worker.execute"
    ],
    "extensions": {
        "control.streams": [
            {
                "id": "message-subscribe",
                "module": "message",
                "operation": "subscribe",
                "scope": "instance"
            }
        ],
        "control.routes": [
            {
                "id": "context-message-list",
                "module": "message",
                "operation": "listContextMessages",
                "scope": "instance"
            },
            {
                "id": "context-message-queue",
                "module": "message",
                "operation": "queueContextMessage",
                "scope": "instance"
            },
            {
                "id": "message-list",
                "module": "message",
                "operation": "listMessageEntries",
                "scope": "instance"
            },
            {
                "id": "message-preferences",
                "module": "message",
                "operation": "preferences",
                "scope": "control"
            },
            {
                "id": "message-update-preferences",
                "module": "message",
                "operation": "updatePreferences",
                "scope": "control"
            }
        ],
        "mcp.tools": [
            {
                "id": "progress_report",
                "activity": "observation",
                "description": "Send a user-visible message without ending the turn or modifying Goal or Memory state. Reply to comments first. #push requires a reply within five tool calls. #stop disables tools until #resume. Otherwise report only meaningful new progress; never repeat reports.",
                "title": "Message user",
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false,
                "inputSchema": {
                    "additionalProperties": false,
                    "properties": {
                        "message": {
                            "description": "User reply or meaningful progress update.",
                            "minLength": 1,
                            "maxLength": 4000,
                            "type": "string"
                        }
                    },
                    "required": [
                        "message"
                    ],
                    "type": "object"
                },
                "outputSchema": {
                    "additionalProperties": false,
                    "properties": {
                        "reported": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "reported"
                    ],
                    "type": "object"
                }
            }
        ],
        "toolcall.review": [
            {
                "hook": "500-toolcall-gate",
                "id": "toolcall-gate"
            }
        ],
        "toolcall.rewrite": [
            {
                "hook": "501-memory-auto",
                "id": "memory-auto"
            },
            {
                "hook": "502-tool-advice",
                "id": "tool-advice"
            },
            {
                "hook": "510-comment-delivery",
                "id": "comment-delivery"
            },
            {
                "hook": "520-mailing-trigger",
                "id": "mailing-trigger"
            }
        ],
        "cli.native-commands": [
            {
                "id": "memory",
                "title": "Memory",
                "summary": "Bind a Context to a persistent Memory and its mailbox",
                "usage": "memory init|inherit|status|list|release"
            }
        ],
        "cli.model-commands": [
            {
                "id": "memory",
                "title": "Memory",
                "summary": "Initialize or inherit a persistent Agent Work Memory",
                "usage": "memory init|inherit|status|list|release"
            }
        ]
    }
}
