{
    "schemaVersion": 1,
    "apiVersion": 4,
    "id": "secret",
    "name": "portable-devshell Secret",
    "version": "0.1.0",
    "entry": "index.ts",
    "capabilities": ["workers"],
    "extensions": {
        "cli.native-commands": [
            {
                "id": "secret",
                "title": "Secret",
                "summary": "Scan text and files for secrets",
                "usage": "secret <command>"
            }
        ],
        "cli.model-commands": [
            {
                "id": "secret",
                "title": "Secret",
                "summary": "Scan the current model Workspace for secrets",
                "usage": "secret scan [directory] [--glob <pattern>] [--limit <n>]"
            }
        ]
    }
}
