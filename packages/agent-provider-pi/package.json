{
    "name": "@portable-devshell/agent-provider-pi",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "devshell-agent-provider.json"
    ],
    "dependencies": {
        "@earendil-works/pi-coding-agent": "0.84.4",
        "@portable-devshell/agentd": "workspace:*",
        "@portable-devshell/pi-extension": "workspace:*",
        "@portable-devshell/shared": "workspace:*",
        "pi-gui-extension": "0.4.1"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b --force",
        "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json",
        "test": "node ../../test/RunPackageTests.mjs --loader ./test/RegisterWorkspacePackages.mjs --concurrency 1 \"test/unit/*.test.ts\""
    }
}
