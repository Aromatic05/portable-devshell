{
    "name": "@portable-devshell/shared",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "default": "./dist/browser.js"
        },
        "./transport/frame": {
            "types": "./dist/transport/frame/Protocol.d.ts",
            "default": "./dist/transport/frame/Protocol.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b --force",
        "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json",
        "test": "node ../../test/RunPackageTests.mjs --loader ./test/RegisterWorkspacePackages.mjs \"test/*.test.mjs\" \"test/unit/*.test.ts\" \"test/unit/presentation/*.test.ts\" \"test/unit/protocol/*.test.ts\" \"test/unit/protocol/control/*.test.ts\" \"test/unit/transport/*.test.ts\" \"test/unit/transport/frame/*.test.ts\" \"test/unit/transport/protocol/*.test.ts\""
    }
}
