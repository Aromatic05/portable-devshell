{
    "name": "@portable-devshell/core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./toolcall": {
            "types": "./dist/tool/Public.d.ts",
            "default": "./dist/tool/Public.js"
        },
        "./approval": {
            "types": "./dist/approval/Public.d.ts",
            "default": "./dist/approval/Public.js"
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@portable-devshell/mcp": "workspace:*",
        "@portable-devshell/shared": "workspace:*",
        "string-argv": "^0.3.2",
        "tar-stream": "3.2.0",
        "ws": "8.21.3"
    },
    "devDependencies": {
        "@types/tar-stream": "^3.1.4",
        "@types/ws": "8.18.1"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b",
        "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json",
        "test": "node ../../test/RunPackageTests.mjs --loader ./test/RegisterWorkspacePackages.mjs --concurrency 1 \"test/*.test.ts\" \"test/unit/*.test.ts\" \"test/unit/*/*.test.ts\" \"test/unit/*/*/*.test.ts\""
    }
}
