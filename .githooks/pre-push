#!/bin/sh
set -eu

dev_shas=""
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/dev*)
            if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
                dev_shas="$dev_shas $local_sha"
            fi
            ;;
    esac
done

if [ -z "$dev_shas" ]; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ -n "$(git status --porcelain)" ]; then
    echo "dev tag push blocked: working tree is not clean" >&2
    exit 1
fi

for local_sha in $dev_shas; do
    node scripts/run-dev-tag-gate.mjs --check "$local_sha"
done
